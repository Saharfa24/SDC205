# Date: August 11, 2026
# Description: This program asks the user to guess a number between 1 and 10.
# It tells the user if the guess is too high, too low, or correct.
# It also demonstrates while and for loops.

userName = input("Enter your name: ")
studentId = input("Enter your Student ID: ")

print()
print("Hello,", userName + "!")
print("Welcome to the Number Guessing Game.")
print("Student ID:", studentId)
print()

correctNumber = 5
guessCount = 0
userGuess = 0

while userGuess != correctNumber:
    userGuess = int(input("Enter a number between 1 and 10: "))
    guessCount += 1

    if userGuess > correctNumber:
        print("Your guess is too high.")
    elif userGuess < correctNumber:
        print("Your guess is too low.")
    else:
        print("Congratulations! You guessed correctly!")

print("Number of tries:", guessCount)
print("Student ID:", studentId)
print()

# While loop
print("Output from the 'while' loop:")

counter = 0
while counter < 5:
    print(counter + 1, "incremented by 1 is", counter + 2)
    counter += 1

print()

# For loop
print("Output from the 'for' loop:")

for counter in range(5):
    print(counter + 1, "incremented by 1 is", counter + 2)
